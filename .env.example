# These are created automatically when you connect the Storage products in the
# Vercel dashboard — you generally do NOT need to fill these in by hand for
# deployment; Vercel injects them into your project's environment for you.
# They're listed here so local `vercel dev` testing works too.

# From: Vercel dashboard -> your project -> Storage -> Blob store -> .env.local tab
BLOB_READ_WRITE_TOKEN=

# From: Vercel dashboard -> your project -> Storage -> Postgres store -> .env.local tab
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=

# Any random string — used only to hash uploader IPs for rate limiting, never stored raw
IP_HASH_SALT=change-me-to-something-random
